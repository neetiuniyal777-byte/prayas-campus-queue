          "type": "dropdown",
          "options": [
            "Scholarship",
            "Passport",
            "Bank",
            "Other"
          ]
        },
        {
          "key": "copies",
          "label": "Copies",
          "type": "number"
        }
      ]
    },
    "fee_certificate": {
