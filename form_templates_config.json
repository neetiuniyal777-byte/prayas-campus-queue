{
  "common_fields": [
    {
      "key": "full_name",
      "label": "Full name",
      "type": "text",
      "required": true,
      "validation": "letters and spaces, 3-80 chars"
    },
    {
      "key": "class_year",
      "label": "Class",
      "type": "dropdown",
      "options": [
        "FE",
        "SE",
        "TE",
        "BE"
      ],
      "required": true
    },
    {
      "key": "branch",
      "label": "Branch",
      "type": "dropdown",
      "options": [
        "Computer Engineering",
        "IT",
        "Mechanical",
        "Civil",
        "Electrical",
        "E&TC"
      ],
      "required": true
    },
    {
      "key": "tuf_id",
      "label": "TUF ID",
      "type": "text",
      "required": true,
      "validation": "pattern set by admin"
    },
    {
      "key": "division",
      "label": "Division / Roll No.",
      "type": "text",
      "required": false
    },
    {
      "key": "academic_year",
      "label": "Academic year",
      "type": "dropdown",
      "options": [
        "2026-27"
      ],
      "required": true
    }
  ],
  "services": {
